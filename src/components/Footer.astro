---
import EmailContact from './EmailContact.astro'
---

<footer>
  <div class="container content-aligned footer-content">
    <div class="contact-row">
      <EmailContact />
      <span class="hello">Say Hello!</span>
    </div>
    <div class="footer-bottom">
      <small>&copy; {new Date().getFullYear()}</small>
      <a
        class="github-link"
        href="https://github.com/aleknik"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.61 1.21 3.24.93.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.61 5.23-5.1 5.51.4.35.76 1.03.76 2.08v3.06c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-content {
    width: min(58rem, calc(100% - 2 * var(--page-gutter)));
    padding-top: 1.75rem;
  }

  .contact-row,
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contact-row {
    min-height: 3.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.email-contact) {
    margin-top: 0;
  }

  .hello {
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .footer-bottom {
    min-height: 4.5rem;
    color: var(--muted);
  }

  small {
    font-size: 0.875rem;
  }

  .github-link {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--muted);
  }

  .github-link svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
  }

  .github-link:hover {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .footer-content {
      padding-top: 1rem;
    }

    .footer-bottom {
      min-height: 3.5rem;
    }
  }
</style>
