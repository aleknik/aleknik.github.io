---
import { contactLinks } from '../data/site'
import Icon from './Icon.astro'

const [linkedIn] = contactLinks
---

<footer>
  <div class="container content-aligned">
    <div class="footer-content">
      <small>&copy; {new Date().getFullYear()}</small>
      <a
        class="linkedin-link"
        href={linkedIn.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {linkedIn.name}
        <Icon name="arrow-up-right" size={14} />
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    min-height: 5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  small {
    font-size: 0.875rem;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .linkedin-link :global(svg) {
    flex: 0 0 auto;
  }

  .linkedin-link:hover {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .footer-content {
      min-height: 4.5rem;
    }
  }
</style>
