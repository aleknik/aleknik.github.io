---
import EmailContact from './EmailContact.astro'
---

<footer>
  <div class="container content-aligned footer-content">
    <div class="contact-row">
      <EmailContact />
      <span class="hello">Let's connect.</span>
    </div>
    <div class="footer-bottom">
      <small>&copy; {new Date().getFullYear()}</small>
      <a
        class="github-link"
        href="https://github.com/aleknik"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile (opens in a new tab)"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.61 1.21 3.24.93.1-.72.39-1.21.71-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.99 0 4.29-2.61 5.23-5.1 5.51.4.35.76 1.03.76 2.08v3.06c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .footer-content {
    padding-top: 0;
  }

  .contact-row,
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contact-row {
    align-items: flex-start;
    gap: 1.5rem;
    min-height: 4rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  :global(.email-contact) {
    min-width: 0;
  }

  .hello {
    color: var(--muted);
    padding-block: 0.625rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .footer-bottom {
    min-height: 5rem;
    color: var(--muted);
  }

  small {
    font-size: 0.875rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .github-link svg {
    flex: 0 0 auto;
    fill: currentColor;
  }

  .github-link:hover {
    color: var(--ink);
  }

  @media (max-width: 480px) {
    .hello {
      display: none;
    }

    .footer-bottom {
      min-height: 4.5rem;
    }
  }
</style>
