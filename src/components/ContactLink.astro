---
import type { ContactLink } from '../data/site'
import Icon from './Icon.astro'

interface Props {
  link: ContactLink
}

const { link } = Astro.props
---

<a
  class:list={['contact-link', { primary: link.primary }]}
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
>
  {link.primary && (
    <span class="linkedin-mark" aria-hidden="true">
      in
    </span>
  )}
  <span>{link.label}</span>
  <Icon name="arrow-up-right" size={15} />
  <span class="sr-only"> (opens in a new tab)</span>
</a>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .contact-link:hover {
    color: var(--ink);
  }

  .primary {
    flex-wrap: wrap;
    justify-content: flex-start;
    text-align: left;
    max-width: 100%;
    min-height: 52px;
    padding: 14px 18px;
    border: 1px solid #5593ff;
    border-radius: 0.625rem;
    color: #fff;
    background: #2160cf;
    font-weight: 600;
    box-shadow: 0 5px 24px #155cce24;
  }

  .primary:hover {
    background: #2a6cdf;
  }

  .linkedin-mark {
    margin-right: 0.25rem;
    font-size: 1.125rem;
    font-weight: 750;
    line-height: 1;
  }

  @media (forced-colors: active) {
    .primary {
      border-color: ButtonText;
    }
  }
</style>
