---
import type { ContactLink } from '../data/site'
import Icon from './Icon.astro'

interface Props {
  link: ContactLink
}

const { link } = Astro.props
---

<a
  class:list={['contact-link', { primary: link.primary }]}
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
>
  {link.primary && (
    <span class="linkedin-mark" aria-hidden="true">
      in
    </span>
  )}
  <span>{link.label}</span>
  <Icon name="arrow-up-right" size={15} />
  <span class="sr-only"> (opens in a new tab)</span>
</a>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .contact-link:hover {
    color: var(--ink);
  }

  .primary {
    justify-content: flex-start;
    text-align: left;
    max-width: 100%;
    min-height: 56px;
    padding: 0.875rem 1.125rem;
    border: 1px solid #4c83df;
    border-radius: 0.75rem;
    color: #fff;
    background: #2160cf;
    font-size: 0.9375rem;
    font-weight: 600;
    box-shadow: 0 4px 16px #0002;
  }

  .primary > span:not(.linkedin-mark, .sr-only) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .primary :global(svg) {
    flex: 0 0 auto;
    margin-left: auto;
  }

  .primary:hover {
    color: #fff;
    border-color: var(--blue);
    background: #2a6cdf;
    box-shadow: 0 6px 20px #0003;
  }

  .linkedin-mark {
    flex: 0 0 auto;
    font-size: 1.375rem;
    font-weight: 750;
    line-height: 1;
  }

  @media (max-width: 480px) {
    .primary {
      width: 100%;
    }
  }

  @media (forced-colors: active) {
    .primary {
      border-color: ButtonText;
    }
  }
</style>
