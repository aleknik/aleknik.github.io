---
import { profile } from '../data/site'
---

<section id="about" aria-labelledby="intro-heading">
  <h1 id="intro-heading">{profile.name}</h1>
  <p>
    {profile.role} in {profile.city}, {profile.country}.
  </p>
</section>

<style>
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.04em;
  }

  p {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }
</style>
