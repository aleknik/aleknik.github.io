---
import { profile } from '../data/site'
import Icon from './Icon.astro'
---

<section id="about" aria-labelledby="intro-heading">
  <h1 id="intro-heading">
    <span>{profile.firstName}</span>{' '}
    <span class="surname">{profile.lastName}</span>
  </h1>
  <div class="details">
    <p class="role">
      <Icon name="code" size={26} />
      {profile.role}
    </p>
    <p class="location">
      <Icon name="map-pin" size={26} />
      {profile.city}, {profile.country}
    </p>
  </div>
</section>

<style>
  h1 {
    margin-bottom: 2.25rem;
    font-size: clamp(3.5rem, 10vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  h1 > span {
    display: block;
  }

  .surname {
    color: var(--blue);
  }

  .details {
    display: grid;
    gap: 0.5rem;
  }

  .role,
  .location {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: clamp(1rem, 3vw, 1.5rem);
  }

  .role :global(svg),
  .location :global(svg) {
    flex: 0 0 auto;
    color: #8795a9;
  }

  @media (max-width: 420px) {
    h1 {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }
  }
</style>
