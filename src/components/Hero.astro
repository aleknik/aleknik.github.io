---
import { profile } from '../data/site'
import Icon from './Icon.astro'
---

<section id="about" aria-labelledby="intro-heading">
  <p class="role">
    <Icon name="code" size={18} />
    {profile.role}
  </p>
  <h1 id="intro-heading">
    <span>{profile.firstName}</span>{' '}
    <span class="surname">{profile.lastName}</span>
  </h1>
  <p class="location">
    <Icon name="map-pin" size={18} />
    {profile.city}, {profile.country}
  </p>
</section>

<style>
  h1 {
    margin-block: 1.5rem;
    font-size: clamp(2.5rem, 6.4vw, 5.5rem);
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  h1 > span {
    display: block;
  }

  .surname {
    color: var(--blue);
  }

  .role,
  .location {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .role {
    color: var(--blue);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .role :global(svg),
  .location :global(svg) {
    flex: 0 0 auto;
  }

  @media (max-width: 480px) {
    h1 {
      font-size: clamp(2.5rem, 10.5vw, 3.125rem);
    }
  }
</style>
