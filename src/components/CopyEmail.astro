---
import Icon from './Icon.astro'

interface Props {
  email: string
}

const { email } = Astro.props
---

<div class="email-copy" data-copy-email={email}>
  <button type="button" hidden>
    <Icon name="copy" size={15} />
    Copy email address
  </button>
  <p role="status" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import { enhanceCopyEmail } from '../lib/copy-email'

  document
    .querySelectorAll<HTMLElement>('[data-copy-email]')
    .forEach((container) => {
      enhanceCopyEmail(container)
    })
</script>

<style>
  .email-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    min-height: 52px;
    margin-top: 1rem;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.125rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--forest);
    font-size: 0.75rem;
    font-weight: 650;
  }

  button:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  button:disabled {
    opacity: 0.65;
  }

  [role='status'] {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
