---
import Icon from './Icon.astro'

interface Props {
  email: string
}

const { email } = Astro.props
---

<div class="email-copy" data-copy-email={email}>
  <button
    type="button"
    aria-label="Copy email address"
    title="Copy email address"
    hidden
  >
    <Icon name="copy" size={15} />
  </button>
  <span role="status" aria-live="polite" aria-atomic="true"></span>
</div>

<script>
  import { enhanceCopyEmail } from '../lib/copy-email'

  document
    .querySelectorAll<HTMLElement>('[data-copy-email]')
    .forEach((container) => {
      enhanceCopyEmail(container)
    })
</script>

<style>
  .email-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    max-width: 100%;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--muted);
  }

  button:hover {
    color: var(--ink);
  }

  button:disabled {
    opacity: 0.65;
  }

  [role='status'] {
    color: var(--muted);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  [role='status']:empty {
    display: none;
  }
</style>
