---
import { emailContact } from '../data/site'
import Icon from './Icon.astro'
---

<details class="email-contact" data-email={emailContact.encoded}>
  <summary>
    Email me <Icon name="plus" size={14} />
  </summary>
  <div class="email-panel">
    <p data-email-address>
      Email requires JavaScript. Please connect on LinkedIn instead.
    </p>
    <div class="email-actions">
      <a data-email-link hidden>
        Open email app <Icon name="arrow-up-right" size={14} />
      </a>
      <button type="button" data-email-copy hidden>
        <Icon name="copy" size={14} /> Copy address
      </button>
    </div>
    <p role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</details>

<script>
  import { enhanceEmailContact } from '../lib/email-contact'

  document
    .querySelectorAll<HTMLDetailsElement>('[data-email]')
    .forEach((details) => {
      enhanceEmailContact(details)
    })
</script>

<style>
  .email-contact {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    min-height: 44px;
    color: var(--blue);
    font-size: 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--ink);
  }

  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .email-panel {
    padding: 0.875rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.625rem;
    background: #0b1423;
    overflow-wrap: anywhere;
  }

  [data-email-address] {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink);
  }

  .email-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  a,
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--blue);
    font-size: 0.75rem;
    text-decoration: none;
  }

  a:hover,
  button:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  [role='status'] {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
