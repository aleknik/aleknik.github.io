---
import Brand from './Brand.astro'
import Icon from './Icon.astro'
---

<header class="site-header container">
  <Brand />
  <nav aria-label="Main navigation">
    <a href="/#about">About</a>
    <a href="/#connect">
      Let's connect <Icon name="arrow-up-right" size={15} />
    </a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.625rem;
    border-bottom: 1px solid var(--line);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  @media (max-width: 479px) {
    .site-header {
      padding-block: 1rem;
    }

    nav {
      gap: 1rem;
    }

    nav a {
      font-size: 0.75rem;
    }

    nav svg {
      display: none;
    }
  }
</style>
