---
import { profile } from '../data/site'
---

<header>
  <div class="container content-aligned header-content">
    <a href="/" aria-label={`${profile.handle}, home`}>
      <img src="/favicon.svg" alt="" width="64" height="64" />
      <span>{profile.handle}</span>
    </a>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--line);
  }

  .header-content {
    width: min(58rem, calc(100% - 2 * var(--page-gutter)));
    padding-block: 1.5rem;
  }

  a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    min-height: 44px;
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 650;
    text-decoration: none;
  }

  img {
    border-radius: 0.75rem;
    box-shadow: 0 0 1.5rem #155cce26;
  }

  @media (max-width: 480px) {
    .header-content {
      padding-block: 1rem;
    }

    img {
      width: 52px;
      height: 52px;
    }
  }
</style>
