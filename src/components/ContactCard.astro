---
import type { ContactLink } from '../data/site'
import Icon from './Icon.astro'

interface Props {
  link: ContactLink
  index: number
}

const { link, index } = Astro.props
---

<a
  class:list={['contact-card', { 'email-card': !link.external }]}
  href={link.href}
  target={link.external ? '_blank' : undefined}
  rel={link.external ? 'noopener noreferrer' : undefined}
  aria-label={`${link.name}${link.external ? ' (opens in a new tab)' : ''}`}
>
  <div class="card-top">
    <span class="channel-icon">
      <Icon name={link.icon} size={21} />
    </span>
    <span class="card-number eyebrow" aria-hidden="true">
      0{index + 1}
    </span>
    <span class="card-arrow">
      <Icon name="arrow-up-right" size={20} />
    </span>
  </div>
  <h3>{link.name}</h3>
  <p>{link.description}</p>
  <span class="card-label">{link.label}</span>
</a>

<style>
  .contact-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1.625rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-raised);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .email-card {
    background: #ecf0e5;
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: #8da18d;
    box-shadow: 0 12px 25px -15px #24483c35;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.875rem;
  }

  .channel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    color: var(--forest);
  }

  .card-number {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.5625rem;
  }

  .card-arrow {
    color: var(--forest);
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  p {
    max-width: 18rem;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.85;
  }

  .card-label {
    margin-top: auto;
    color: var(--forest);
    font-family: var(--mono);
    font-size: 0.6875rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .contact-card {
      padding: 1.375rem;
    }

    .card-top {
      margin-bottom: 1.375rem;
    }

    p {
      max-width: none;
    }
  }

  @media (hover: none) {
    .contact-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>
