---
import { profile } from '../data/site'
---

<a class="brand" href="/" aria-label={`${profile.name}, home`}>
  <img src="/favicon.svg" width="40" height="40" alt="" />
  <span>
    {profile.handle}
    <span class="brand-dot">.</span>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    border-radius: 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.055em;
  }

  .brand img {
    flex-shrink: 0;
  }

  .brand-dot {
    color: var(--forest);
  }
</style>
