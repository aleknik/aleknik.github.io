---
import { profile } from '../data/site'
import Icon from './Icon.astro'
---

<aside class="location-card" aria-label="Based in Belgrade, Serbia">
  <div class="card-heading eyebrow">
    <span>Somewhere on this planet</span>
    <span class="plus" aria-hidden="true">
      +
    </span>
  </div>

  <div class="artwork" aria-hidden="true">
    <svg viewBox="0 0 400 300" fill="none" focusable="false">
      <g stroke="#9fbd9e" stroke-opacity=".2">
        <path d="M0 75h400M0 150h400M0 225h400M100 0v300M200 0v300M300 0v300" />
        <circle cx="200" cy="150" r="115" />
        <circle cx="200" cy="150" r="87" stroke-dasharray="2 6" />
        <ellipse
          cx="200"
          cy="150"
          rx="168"
          ry="53"
          transform="rotate(-30 200 150)"
        />
        <ellipse
          cx="200"
          cy="150"
          rx="168"
          ry="53"
          transform="rotate(30 200 150)"
        />
      </g>
      <g transform="translate(73 16) scale(4)">
        <path d="M32 16 17 48h16l-3-7h-3l5-11 8 18h8L34 16Z" fill="#d6efb5" />
        <path d="m32 16 2 0 14 32h-8L29 23Z" fill="#91b889" />
        <path d="m29 23 3 7-5 11h3l3 7H17Z" fill="#e2f3ca" />
      </g>
      <circle cx="326" cy="86" r="5" fill="#d6efb5" />
      <circle cx="326" cy="86" r="11" stroke="#d6efb5" stroke-opacity=".3" />
      <path d="M52 248h12m-6-6v12M342 234h12m-6-6v12" stroke="#9fbd9e" />
    </svg>
  </div>

  <div class="card-footer">
    <p class="based-in">
      <Icon name="pin" size={15} /> Based in
    </p>
    <p class="city">
      {profile.city}
      <span>{profile.country}</span>
    </p>
    <p class="coordinates eyebrow">44.7866 N &nbsp; / &nbsp; 20.4489 E</p>
  </div>
</aside>

<style>
  .location-card {
    position: relative;
    overflow: hidden;
    align-self: center;
    padding: 1.5rem;
    border: 1px solid #24483c;
    border-radius: 1.5rem;
    background: #24483c;
    color: #f1f7eb;
  }

  .card-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    color: #d0ddc8;
    font-size: 0.5625rem;
  }

  .plus {
    font-size: 1rem;
    line-height: 1;
  }

  .artwork {
    margin: 0.75rem -1.5rem 0;
  }

  .artwork svg {
    width: 100%;
    height: auto;
  }

  .card-footer {
    position: relative;
    margin-top: -0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #4b6a59;
  }

  .based-in {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #cfddc8;
    font-size: 0.6875rem;
  }

  .city {
    margin-top: 0.375rem;
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }

  .city span {
    color: #cfddc8;
    font-weight: 400;
  }

  .city span::before {
    content: ', ';
  }

  .coordinates {
    margin-top: 0.625rem;
    color: #c4d3bd;
    font-size: 0.5625rem;
    letter-spacing: 0.07em;
  }

  @media (max-width: 767px) {
    .location-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 1.25rem;
    }

    .card-heading {
      grid-column: 1 / -1;
    }

    .artwork {
      grid-column: 2;
      grid-row: 2;
      margin: 0 -1.25rem 0 0;
    }

    .card-footer {
      grid-column: 1;
      grid-row: 2;
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .city span {
      display: block;
      font-size: 1rem;
    }

    .city span::before {
      content: none;
    }

    .coordinates {
      max-width: 7rem;
      line-height: 1.9;
    }
  }
</style>
